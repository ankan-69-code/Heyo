<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Special Question ❤️</title>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@500&display=swap" rel="stylesheet">
    <style>
        :root { --primary-pink: #ff4d6d; }
        body {
            margin: 0; padding: 0; display: flex;
            justify-content: center; align-items: center;
            height: 100vh; background: linear-gradient(135deg, #ffeef2 0%, #ffccd5 100%);
            font-family: 'Quicksand', sans-serif; overflow: hidden;
        }

        /* Moving Hearts Background */
        .heart {
            position: absolute; bottom: -50px; color: var(--primary-pink);
            user-select: none; pointer-events: none;
            animation: floatUp linear infinite; z-index: 1;
        }
        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg); opacity: 0; }
            20% { opacity: 0.6; }
            100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
        }

        .container {
            background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px);
            padding: 40px; border-radius: 40px;
            box-shadow: 0 15px 35px rgba(255, 77, 109, 0.2);
            text-align: center; width: 350px; z-index: 10; border: 2px solid white;
        }

        #bearGif { width: 160px; margin-bottom: 10px; }
        h1 { font-family: 'Dancing Script', cursive; color: #c9184a; font-size: 2.8rem; margin-bottom: 30px; }
        
        .btn-group {
            display: flex; justify-content: center; align-items: center;
            gap: 50px; min-height: 150px;
        }

        button {
            padding: 12px 28px; font-size: 1.1rem; font-weight: bold;
            border: none; border-radius: 50px; cursor: pointer;
            transition: transform 0.2s ease-out;
        }

        #yesBtn { background-color: var(--primary-pink); color: white; z-index: 11; }
        #noBtn { background-color: #adb5bd; color: white; z-index: 1000; transition: 0.1s ease; }
    </style>
</head>
<body>

    <audio id="bgMusic" loop>
        <source src="http://googleusercontent.com/file_content/0" type="audio/mpeg">
    </audio>

    <div class="container" id="mainBox">
        <img id="bearGif" src="https://media.tenor.com/r_2wMCBMnesAAAAi/bubu-bubu-dudu-love.gif" alt="Cute Bear">
        <h1 id="question">Do you love me?</h1>
        <div class="btn-group" id="buttons">
            <button id="yesBtn" onclick="celebrate()">Yes</button>
            <button id="noBtn" onmouseover="moveButton()" onclick="moveButton()">No</button>
        </div>
    </div>

    <script>
        const music = document.getElementById('bgMusic');
        let musicStarted = false;
        let yesScale = 1.0;

        // Infinite Hearts Spawner
        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('heart');
            heart.innerHTML = '❤️';
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.fontSize = (Math.random() * 15 + 10) + 'px';
            heart.style.animationDuration = (Math.random() * 3 + 3) + 's';
            document.body.appendChild(heart);
            setTimeout(() => { heart.remove(); }, 6000);
        }
        setInterval(createHeart, 300);

        // Random Move Logic with Strict Screen Boundaries
        function moveButton() {
            // Play your uploaded song on first interaction
            if (!musicStarted) { music.play(); musicStarted = true; }

            const noBtn = document.getElementById('noBtn');
            const yesBtn = document.getElementById('yesBtn');

            // Grow Yes Button
            yesScale *= 1.3;
            yesBtn.style.transform = `scale(${yesScale})`;

            // Unhook from center and allow random movement
            noBtn.style.position = 'fixed';

            const padding = 30; 
            const maxX = window.innerWidth - noBtn.offsetWidth - padding;
            const maxY = window.innerHeight - noBtn.offsetHeight - padding;

            const randomX = Math.max(padding, Math.floor(Math.random() * maxX));
            const randomY = Math.max(padding, Math.floor(Math.random() * maxY));

            noBtn.style.left = randomX + "px";
            noBtn.style.top = randomY + "px";
        }

        function celebrate() {
            if (!musicStarted) music.play(); //
            document.getElementById('mainBox').innerHTML = `
                <img src="https://media.tenor.com/OrxXcqX25KcAAAAi/dudu-bubu-love-gif.gif" width="160">
                <h1 style="font-size: 3rem;">I knew itt! ❤️</h1>
                <p style="color: #ff4d6d; font-weight: bold; font-size: 1.2rem;">YEAAAAA !!🫠</p>
            `;
            setInterval(createHeart, 100);
        }
    </script>
</body>
</html>
